# ==============================================================================
# FlowPilot AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment.

# Node environment mode: 'development', 'test', or 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# Core Server Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=4001
API_URL=http://localhost:4001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowpilot_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowpilot_test?schema=public"

# Redis Connection URL (Optional for local dev - in-process queue adapter is used when Redis is absent)
REDIS_URL="redis://localhost:6379"

# Session & Security Settings
SESSION_SECRET=flowpilot_super_secret_session_key_32_characters_minimum_length_required!
SESSION_COOKIE_NAME=flowpilot_session
SESSION_MAX_AGE_HOURS=24
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Credential Encryption Key for sensitive third-party integration tokens (32-byte hex or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# AI Service Configuration (apps/ai)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_PROVIDER=mock # Options: 'mock', 'openai', 'gemini', 'anthropic'
AI_MODEL=gpt-4o-mini
AI_API_KEY=mock-dev-key

# ------------------------------------------------------------------------------
# Web Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="FlowPilot AI"
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
