{
  "name": "flowpilot-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FlowPilot AI — Intelligent Workflow Automation Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@flowpilot/api",
    "dev:all": "concurrently \"npm run dev --workspace=@flowpilot/api\" \"npm run dev --workspace=@flowpilot/web\"",
    "dev:api": "npm run dev --workspace=@flowpilot/api",
    "dev:web": "npm run dev --workspace=@flowpilot/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.19.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
